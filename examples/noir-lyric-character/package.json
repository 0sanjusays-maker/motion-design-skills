{
  "name": "noir-character-lyric",
  "private": true,
  "type": "module",
  "description": "गुमराहों का रास्ता — a 48-second Hindi lyric film acted by one hand-rigged character",
  "scripts": {
    "audio": "node src/audio.js --out assets/ambience.wav --dur 48",
    "stills": "node src/render.js --still 1.6,8,16.8,21.6,27.6,32,36.2,43,46.4 --out stills",
    "render": "node src/render.js --video assets/gumraahon-ka-raasta.mp4 --crf 20",
    "gif": "ffmpeg -y -i assets/gumraahon-ka-raasta.mp4 -vf \"fps=4,scale=260:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=48:stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=5\" -loop 0 ../noir-character-lyric.gif"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.60",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource/tiro-devanagari-hindi": "^5.0.0",
    "@fontsource/mukta": "^5.0.0"
  }
}
